				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"//Step 1: Make a GET request to fetch all booking IDs\r",
							"pm.sendRequest(\"https://restful-booker.herokuapp.com/booking\", function (err, response) {\r",
							"    if (err) {\r",
							"        console.log(\"Error fetching bookings:\", err);\r",
							"    } else {\r",
							"        let bookingList = response.json();\r",
							"\r",
							"        if (bookingList.length > 0) {\r",
							"            // Step 2: Pick a random booking ID\r",
							"            let randomIndex = Math.floor(Math.random() * bookingList.length);\r",
							"            let randomBookingID = bookingList[randomIndex].bookingid;\r",
							"\r",
							"            // Step 3: Store the ID in an environment variable\r",
							"            pm.environment.set(\"booking_id\", randomBookingID);\r",
							"            console.log(\"Random Booking ID selected:\", randomBookingID);\r",
							"        } else {\r",
							"            console.log(\"No bookings found!\");\r",
							"        }\r",
							"    }\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
